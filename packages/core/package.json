{
  "name": "@live-favicon/core",
  "version": "0.2.0",
  "description": "Turn your browser tab into a live status indicator.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "favicon",
    "browser-tab",
    "status",
    "notification",
    "progress",
    "canvas",
    "sound",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cridorainfo/live-favicon.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cridorainfo/live-favicon#readme",
  "bugs": {
    "url": "https://github.com/cridorainfo/live-favicon/issues"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
